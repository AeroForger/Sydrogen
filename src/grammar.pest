// Sydrogen Grammar v2 - pest PEG port
// PEG: NO left recursion. Precedence via nested rules.
// High → low: primary > postfix > power > unary > mul > add
//             > comparison > and > or > xor
// Documented decision: unary binds LOOSER than **, so -2 ** 2 == -4.

WHITESPACE   = _{ " " | "\t" | "\r" | "\n" | COMMENT | LINE_COMMENT }
COMMENT      = _{ "-[" ~ (!"]-" ~ ANY)* ~ "]-" }
LINE_COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* }

program    = { SOI ~ statement* ~ EOI }

statement  = {
      using_stmt
    | use_stmt
    | data_decl
    | function_decl
    | var_decl
    | object_decl
    | print_stmt
    | foreach_stmt
    | switch_stmt
    | do_stmt
    | throw_stmt
    | for_stmt
    | if_stmt
    | while_stmt
    | return_stmt
    | stop_stmt
    | skip_stmt
    | input_stmt
    | assignment
    | expr_stmt
}

// --- Imports ---
use_stmt        = { kw_use ~ qualified_name ~ ";" }
using_stmt      = { kw_using ~ qualified_name ~ ":" ~ using_item ~ ";" }
qualified_name  = { ident ~ ("." ~ ident)* }
using_item      = { ident ~ ("(" ~ ")")? }

// --- Modifiers & types ---
modifier        = { kw_open | kw_closed | kw_showcase }
subtype         = { kw_int | kw_float | kw_weld | kw_string | kw_generic }
type_decl       = { number_type | weld_type | bool_type | ore_type | materials_type }

number_type     = { kw_number? ~ numeric_subtype }
numeric_subtype = { kw_int | kw_float }
weld_type       = { kw_weld | kw_string }
bool_type       = { kw_bool | kw_boolean }
ore_type        = { (kw_ore ~ "[" ~ (integer | kw_empty)? ~ "]") | (kw_ore ~ "(" ~ tuple_field ~ ("," ~ tuple_field)* ~ ","? ~ ")") }
tuple_field     = { subtype ~ ident }
materials_type  = { kw_materials ~ subtype ~ kw_new? }

// --- Collection Literals ---
array_init      = { "[" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "]" }
tuple_init      = { "{" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "}" }
list_init       = { "(" ~ (expr ~ ("," ~ expr)+ ~ ","? | expr ~ "," | "") ~ ")" }

// --- Variable declaration ---
var_decl        = { modifier? ~ type_decl ~ ident ~ ("=" ~ expr)? ~ ";" }

// --- Data types & objects ---
data_decl       = { modifier? ~ kw_data ~ ident ~ "{" ~ member_decl* ~ "}" }
member_decl     = { modifier? ~ type_decl ~ ident ~ ";" }

object_decl     = { ident ~ ident ~ "{" ~ member_init* ~ "}" }
member_init     = { ident ~ ("." ~ ident)* ~ "=" ~ expr ~ (";" | ",")? }

// --- Functions ---
function_decl   = { modifier? ~ ret_kind ~ ident ~ "(" ~ param_list? ~ ")" ~ block }
ret_kind        = { type_decl | kw_generic | kw_function | kw_nunction }

param_list      = { param ~ ("," ~ param)* }
param           = { type_decl ~ ident }
block           = { "{" ~ statement* ~ "}" }

// --- Print / Input ---
print_stmt      = { kw_print ~ "(" ~ expr ~ ")" ~ ";" }
input_stmt      = { kw_input ~ "(" ~ subtype? ~ ")" ~ ";" }

// --- Control flow ---
if_stmt         = { kw_if ~ "(" ~ expr ~ ")" ~ block
                  ~ (kw_else ~ kw_if ~ "(" ~ expr ~ ")" ~ block)*
                  ~ (kw_else ~ block)? }
while_stmt      = { kw_while ~ "(" ~ expr ~ ")" ~ block }
for_stmt        = { kw_for ~ "(" ~ for_init ~ ";" ~ expr ~ ";" ~ for_increment ~ ")" ~ block }
foreach_stmt    = { kw_foreach ~ "(" ~ type_decl ~ ident ~ kw_in ~ ident ~ ")" ~ block }
switch_stmt     = { kw_switch ~ "(" ~ expr ~ ")" ~ "{" ~ switch_branch* ~ "}" }
switch_branch   = _{ switch_case | switch_base }
switch_case     = { kw_case ~ ("->" ~ case_values ~ ":" ~ statement | case_values ~ ("->" ~ statement | block)) }
case_values     = { expr ~ (kw_case_or ~ expr)* }
switch_base     = { kw_base ~ ("->" ~ statement | block) }
for_init        = { modifier? ~ type_decl ~ ident ~ ("=" ~ expr)? }
for_increment   = { ident ~ incr_op }
incr_op         = { "++" | "--" }
return_stmt     = { kw_return ~ expr? ~ ";" }
stop_stmt       = { kw_stop ~ ";" }
skip_stmt       = { kw_skip ~ ";" }
do_stmt         = { kw_do ~ block ~ catch_clause* ~ finally_clause? }
catch_clause    = { kw_catch ~ error_type ~ "=>" ~ ident ~ block }
finally_clause  = { kw_finally ~ block }
throw_stmt      = { kw_throw ~ error_construct ~ ";" }
error_construct = { error_type ~ "(" ~ expr ~ ")" }
error_type      = { kw_error ~ ("." ~ member_ident)? }

// --- Assignment & bare expr ---
assignment      = { assignment_target ~ "=" ~ expr ~ ";" }
assignment_target = { ident ~ (("." ~ member_ident) | index_tail)* }
expr_stmt       = { expr ~ ";" }

// --- Expressions: nested precedence ---
expr              = { xor_expr }
xor_expr          = { or_expr ~ (kw_xor ~ or_expr)* }
or_expr           = { and_expr ~ (kw_or ~ and_expr)* }
and_expr          = { comparison ~ (kw_and ~ comparison)* }
comparison        = { additive ~ (comp_op ~ additive)* }
additive          = { multiplicative ~ (add_op ~ multiplicative)* }
multiplicative    = { unary ~ (mul_op ~ unary)* }
unary             = { (unary_op)* ~ power }
power             = { postfix ~ (pow_op ~ power)? }
postfix           = { primary ~ (("." ~ member_ident) | index_tail | call_tail)* }
member_ident      = ${ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
index_tail        = { "[" ~ expr ~ "]" }
call_tail         = { "(" ~ arg_list? ~ ")" }
arg_list          = { expr ~ ("," ~ expr)* }
primary           = {
    list_init
  | "(" ~ expr ~ ")"
  | interpolated_string
  | string
  | number
  | bool_literal
  | input_expr
  | ident
  | array_init
  | tuple_init
}
input_expr        = { kw_input ~ "(" ~ subtype? ~ ")" }

// --- Named operator rules (appear in parse tree) ---
comp_op         = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
add_op          = { "+" | "-" }
mul_op          = { "*" | "/" | "%" }
pow_op          = { "**" }
unary_op        = { "+" | "-" }

// --- Keyword Tokens (Atomic so they don't skip whitespace before !ident_char) ---
kw_open       = ${ "Open" ~ !ident_char }
kw_closed     = ${ "Closed" ~ !ident_char }
kw_showcase   = ${ "Showcase" ~ !ident_char }
kw_number     = ${ "Number" ~ !ident_char }
kw_weld       = ${ "Weld" ~ !ident_char }
kw_string     = ${ "String" ~ !ident_char }
kw_ore        = ${ "Ore" ~ !ident_char }
kw_materials  = ${ "Materials" ~ !ident_char }
kw_data       = ${ "Data" ~ !ident_char }
kw_int        = ${ "Int" ~ !ident_char }
kw_float      = ${ "Float" ~ !ident_char }
kw_generic    = ${ "Generic" ~ !ident_char }
kw_function   = ${ "function" ~ !ident_char }
kw_nunction   = ${ "Nunction" ~ !ident_char }
kw_return     = ${ "Return" ~ !ident_char }
kw_if         = ${ "If" ~ !ident_char }
kw_while      = ${ "While" ~ !ident_char }
kw_else       = ${ "Else" ~ !ident_char }
kw_switch     = ${ "Switch" ~ !ident_char }
kw_deal       = ${ "Deal" ~ !ident_char }
kw_case       = ${ "Case" ~ !ident_char }
kw_case_or    = ${ "or" ~ !ident_char }
kw_base       = ${ "Base" ~ !ident_char }
kw_do         = ${ "Do" ~ !ident_char }
kw_catch      = ${ "Catch" ~ !ident_char }
kw_finally    = ${ "Finally" ~ !ident_char }
kw_throw      = ${ "Throw" ~ !ident_char }
kw_error      = ${ "Error" ~ !ident_char }
kw_invalid_value = ${ "InvalidValue" ~ !ident_char }
kw_division_by_zero = ${ "DivisionByZero" ~ !ident_char }
kw_overflow   = ${ "Overflow" ~ !ident_char }
kw_io         = ${ "IO" ~ !ident_char }
kw_fail       = ${ "Fail" ~ !ident_char }
kw_final      = ${ "Final" ~ !ident_char }
kw_and        = ${ "And" ~ !ident_char }
kw_or         = ${ "Or" ~ !ident_char }
kw_xor        = ${ "Xor" ~ !ident_char }
kw_use        = ${ "Use" ~ !ident_char }
kw_using      = ${ "Using" ~ !ident_char }
kw_new        = ${ ("New" | "new") ~ !ident_char }
kw_print      = ${ "Print" ~ !ident_char }
kw_input      = ${ "Input" ~ !ident_char }
kw_stop       = ${ "Stop" ~ !ident_char }
kw_skip       = ${ "Skip" ~ !ident_char }
kw_empty      = ${ "EMPTY" ~ !ident_char }
kw_for        = ${ "For" ~ !ident_char }
kw_foreach    = ${ "ForEach" ~ !ident_char }
kw_in         = ${ "in" ~ !ident_char }
kw_bool       = ${ "Bool" ~ !ident_char }
kw_boolean    = ${ "Boolean" ~ !ident_char }
kw_true       = ${ "true" ~ !ident_char }
kw_false      = ${ "false" ~ !ident_char }

// --- Lexical Tokens ---
ident              = ${ !keyword ~ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
ident_char         = _{ ASCII_ALPHANUMERIC | "_" }
keyword            = _{ 
    kw_open | kw_closed | kw_showcase | kw_number | kw_weld | kw_string | kw_ore
    | kw_materials | kw_data | kw_int | kw_float | kw_generic | kw_function
    | kw_nunction | kw_return | kw_if | kw_while | kw_else | kw_switch | kw_deal | kw_case
    | kw_base | kw_do | kw_catch | kw_finally | kw_throw | kw_error
    | kw_invalid_value | kw_division_by_zero | kw_overflow | kw_io
    | kw_fail | kw_final | kw_and | kw_or | kw_xor
    | kw_use | kw_using | kw_new | kw_print | kw_input | kw_stop | kw_skip | kw_empty
    | kw_for | kw_foreach | kw_in | kw_bool | kw_boolean | kw_true | kw_false
}

number             = { float | integer }
integer            = ${ ASCII_DIGIT+ }
float              = ${ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }

bool_literal       = ${ kw_true | kw_false }

string             = ${ "\"" ~ (escape | string_char)* ~ "\"" }
interpolated_string = ${ "\\V\"" ~ (escape | interpolation | interp_char)* ~ "\"" }
string_char        = { !("\"" | "\\") ~ ANY }
interp_char        = { !("\"" | "\\") ~ !"{" ~ ANY }
interpolation      = { "{" ~ ident ~ ("." ~ ident)* ~ "}" }
escape             = { "\\" ~ ("n" | "t" | "r" | "0" | "\\" | "\"") }
